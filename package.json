{
  "name": "pimo-info",
  "version": "0.1.0",
  "private": true,
  "description": "Help center and knowledge base for the PIMO Criativo ecosystem",
  "scripts": {
    "dev": "next",
    "build": "next build",
    "start": "next start",
    "kb:generate": "node scripts/generate-kb-artifacts.cjs && node scripts/generate-blog-rss.cjs && node scripts/generate-coverage.cjs && node scripts/generate-mini-sites.cjs",
    "kb:normalize": "node scripts/normalize-frontmatter.cjs",
    "precheck": "npm run kb:generate",
    "check": "node scripts/check-kb.cjs && node scripts/check-no-emdash.cjs",
    "check:sitemap": "node scripts/check-sitemap-canonical.cjs",
    "strip-dashes": "node scripts/strip-em-dashes.cjs",
    "preexport": "npm run kb:generate",
    "export": "STATIC_EXPORT=true next build",
    "postexport": "node scripts/check-sitemap-canonical.cjs",
    "indexnow": "node scripts/indexnow-ping.cjs",
    "blog:rss": "node scripts/generate-blog-rss.cjs",
    "coverage": "node scripts/generate-coverage.cjs",
    "minisites": "node scripts/generate-mini-sites.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "next": "^14.2.28",
    "nextra": "^3.3.1",
    "nextra-theme-docs": "^3.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  }
}
