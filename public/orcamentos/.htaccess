Options -Indexes
DirectoryIndex index.html

# Impedir indexação
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /orcamentos/

  # Bloquear listagens e ficheiros sensíveis
  RewriteRule ^api/lib/ - [F,L]
  RewriteRule ^api/bootstrap\.php$ - [F,L]

  # Slash canónico: /orcamentos/<slug> → /orcamentos/<slug>/
  RewriteRule ^([a-z0-9][a-z0-9-]*)$ $1/ [R=301,L,NC]

  # /orcamentos/<slug>/ → SPA (preserva ?v=token)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9][a-z0-9-]*)/?$ index.html [L,QSA,NC]
</IfModule>

# PHP: não expor listagens
<FilesMatch "\.(json|md|sql|log)$">
  Require all denied
</FilesMatch>
